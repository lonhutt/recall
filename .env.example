RECALL_DATABASE_URL=postgres://recall:recall@localhost:5432/recall?sslmode=disable
RECALL_EMBEDDING_BASE_URL=http://127.0.0.1:8091
RECALL_EMBEDDING_MODEL=ggml-org/embeddinggemma-300M-qat-q4_0-GGUF
# Defaults below match EmbeddingGemma's asymmetric-retrieval prompt convention.
# Override if you switch to a model with a different (or no) convention.
# Quoted because the trailing space is significant and the value contains a
# shell-special "|" character (matters if you ever `source` this file).
RECALL_EMBEDDING_QUERY_PREFIX="task: search result | query: "
RECALL_EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
RECALL_MIGRATE_ON_START=true
RECALL_TRANSPORT=stdio
RECALL_HTTP_PORT=8092
RECALL_HTTP_TOKEN=
